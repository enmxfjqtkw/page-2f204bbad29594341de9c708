margin-top: 2rem;display: flex;flex-direction: column;gap: 2rem}\n.faq-item {counter-increment: faq-counter;display: grid;grid-template-columns: 80px 1fr;padding: 1.5rem 0;border-bottom: 1px solid var(--border-subtle)}\n.faq-item:last-child {border-bottom: none}\n.faq-index {font-family: var(--font-serif);font-size: 1.5rem;font-weight: 700;color: var(--cyan-dark);line-height: 1}\n.faq-content h3 {font-size: 1.1rem;font-weight: 600;color: var(--slate-dark);margin-bottom: 0.75rem}\n.faq-content p {font-size: 0.92rem;color: var(--text-muted);line-height: 1.7}\nfooter.site-footer {margin-top: 6rem;border-top: 1px solid var(--border-subtle);padding: 2.5rem 2rem;text-align: center;font-size: 0.8rem;color: var(--text-subtle)}\n@media (max-width: 1024px) {\n  .hero-magazine {grid-template-columns: 1fr 1fr}\n  .hero-col-aside {grid-column: span 2;display: grid;grid-template-columns: repeat(3, 1fr)}\n  .plan-row-item {grid-template-columns: 1fr 1fr;gap: 1.5rem}\n  .plan-specs {grid-column: span 2}\n  .plan-action {grid-column: span 2;text-align: left}\n}\n@media (max-width: 768px) {\n  .hero-magazine {grid-template-columns: 1fr}\n  .hero-col-quote {border-left: none;border-top: 1px solid var(--border-subtle);padding-left: 0;padding-top: 1.5rem}\n  .hero-col-aside {grid-column: auto;grid-template-columns: 1fr}\n  .plan-row-item {grid-template-columns: 1fr;padding: 1.75rem}\n  .plan-specs {grid-column: auto}\n  .plan-action {grid-column: auto}\n  .guide-grid, .clients-grid {grid-template-columns: 1fr}\n  .faq-item {grid-template-columns: 50px 1fr}\n}\n</style><header class=\"site-nav\">\n  <div class=\"nav-inner\">\n    <a href=\"#\" class=\"nav-brand\">慈善机场</a>\n    <ul class=\"nav-links\">\n      <li><a href=\"#overview\">概述</a></li>\n      <li><a href=\"#plans\">订阅规格</a></li>\n      <li><a href=\"#workflow\">导入流程</a></li>\n      <li><a href=\"#clients\">终端说明</a></li>\n      <li><a href=\"#faq\">常见问题</a></li>\n    </ul>\n  </div>\n</header>\n\n<main>\n  <section class=\"hero-magazine\" id=\"overview\">\n    <div class=\"hero-col-main\">\n      <div>\n        <span class=\"meta-tag\">协议中继与分流规范</span>\n        <h1 class=\"brand-title\">慈善机场</h1>\n      </div>\n      <p class=\"lead-text\">慈善机场是一套面向分布式网络访问的参数化接入服务，依据配额周期与设备承载容量提供结构化订阅规则。本文档用于明确各项方案的技术边界与客户端通用接入流程。</p>\n    </div>\n    <div class=\"hero-col-quote\">\n      <blockquote>\n        “网络路由应当依照严格的参数规范分流，以保持各节点吞吐配额的透明度与可追溯性。”\n      </blockquote>\n      <div class=\"quote-caption\">系统调度说明 · 资源管理规约</div>\n    </div>\n    <div class=\"hero-col-aside\">\n      <div class=\"aside-block\">\n        <div class=\"aside-label\">基准配额阶梯</div>\n        <div class=\"aside-value\">100G — 1000G</div>\n        <div class=\"aside-desc\">以自然月或计费周期为重置单位</div>\n      </div>\n      <div class=\"aside-block\">\n        <div class=\"aside-label\">并行终端限制</div>\n        <div class=\"aside-value\">3 至 20 设备</div>\n        <div class=\"aside-desc\">依据不同订阅层级执行在线会话核验</div>\n      </div>\n      <div class=\"aside-block\">\n        <div class=\"aside-label\">链路交付格式</div>\n        <div class=\"aside-value\">Universal Sub</div>\n        <div class=\"aside-desc\">兼容开源核心与多平台通用解析器</div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"plans-section\" id=\"plans\">\n    <div class=\"section-header\">\n      <div class=\"section-pretitle\">Specifications &amp; Quota</div>\n      <h2 class=\"section-title\">订阅方案与配额指标</h2>\n      <p class=\"section-desc\">系统提供三种标准接入规格，各项方案按月度周期划定流量限额与并发终端数上限。</p>\n    </div>\n\n    <div class=\"plan-rows\">\n      <article class=\"plan-row-item\">\n        <div class=\"plan-header\">\n          <h3>基础版</h3>\n          <span class=\"plan-tier-flag\">入门接入层</span>\n        </div>\n        <div class=\"plan-pricing\">\n          <div class=\"price-main\">¥15 / 月</div>\n          <span class=\"price-cycle\">按年付仅需 ¥150/年</span>\n        </div>\n        <ul class=\"plan-specs\">\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n        <div class=\"plan-action\">\n          <a href=\"#\" class=\"action-link\">选择基础版</a>\n        </div>\n      </article>\n\n      <article class=\"plan-row-item highlight\">\n        <div class=\"plan-header\">\n          <h3>旗舰版</h3>\n          <span class=\"plan-tier-flag\">标准推荐层</span>\n        </div>\n        <div class=\"plan-pricing\">\n          <div class=\"price-main\">¥35 / 月</div>\n          <span class=\"price-cycle\">按年付仅需 ¥350/年</span>\n        </div>\n        <ul class=\"plan-specs\">\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n        </ul>\n        <div class=\"plan-action\">\n          <a href=\"#\" class=\"action-link\">选择旗舰版</a>\n        </div>\n      </article>\n\n      <article class=\"plan-row-item\">\n        <div class=\"plan-header\">\n          <h3>团队版</h3>\n          <span class=\"plan-tier-flag\">多端并发层</span>\n        </div>\n        <div class=\"plan-pricing\">\n          <div class=\"price-main\">¥85 / 月</div>\n          <span class=\"price-cycle\">按年付仅需 ¥850/年</span>\n        </div>\n        <ul class=\"plan-specs\">\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n        <div class=\"plan-action\">\n          <a href=\"#\" class=\"action-link\">选择团队版</a>\n        </div>\n      </article>\n    </div>\n  </section>\n\n  <section class=\"guide-section\" id=\"workflow\">\n    <div class=\"section-header\">\n      <div class=\"section-pretitle\">Standard Workflow</div>\n      <h2 class=\"section-title\">订阅载入与运行步骤</h2>\n      <p class=\"section-desc\">客户端的初始化需遵循标准化订阅分发协议，按照既定顺序完成配置同步。</p>\n    </div>\n\n    <div class=\"guide-grid\">\n      <div class=\"guide-col\">\n        <div class=\"step-num\">STEP 01</div>\n        <h3>提取订阅凭证</h3>\n        <p>进入账户控制台，获取系统生成的唯一订阅 URL。凭证字符串包含节点解析元数据与身份鉴权哈希，应妥善保存并避免泄露。</p>\n      </div>\n      <div class=\"guide-col\">\n        <div class=\"step-num\">STEP 02</div>\n        <h3>载入本地客户端</h3>\n        <p>在支持通用代理协议的客户端配置管理器中，新建远程订阅或规则集，将订阅链接粘贴至对应输入栏并触发同步拉取。</p>\n      </div>\n      <div class=\"guide-col\">\n        <div class=\"step-num\">STEP 03</div>\n        <h3>设定路由分流</h3>\n        <p>根据本地网络环境选择“绕过局域网及大陆地址”或“按规则分流”模式，核验系统延迟后选定工作节点并启用核心进程。</p>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"clients-section\" id=\"clients\">\n    <div class=\"section-header\">\n      <div class=\"section-pretitle\">Compatibility</div>\n      <h2 class=\"section-title\">客户端环境适配说明</h2>\n      <p class=\"section-desc\">慈善机场的下发规则适配主流跨平台分流工具，用户需自行通过对应系统渠道安装受信任的开源客户端。</p>\n    </div>\n\n    <div class=\"clients-grid\">\n      <div class=\"client-box\">\n        <div class=\"client-os\">Windows</div>\n        <div class=\"client-env\">系统版本 10 / 11</div>\n        <p class=\"client-details\">建议选用支持 TUN 虚拟网卡模式及 Clash、Sing-box 核心的桌面分流客户端。注意放行系统防火墙出站规则。</p>\n      </div>\n      <div class=\"client-box\">\n        <div class=\"client-os\">macOS</div>\n        <div class=\"client-env\">macOS 12.0 及更高</div>\n        <p class=\"client-details\">适用于通用图形分流软件或命令行核心。首次载入需授予系统网络扩展与分流配置权限。</p>\n      </div>\n      <div class=\"client-box\">\n        <div class=\"client-os\">Android</div>\n        <div class=\"client-env\">Android 8.0 及更高</div>\n        <p class=\"client-details\">支持通过系统 VpnService 运行的通用客户端。建议在电池优化设置中将客户端列入无限制名单以防后台中断。</p>\n      </div>\n      <div class=\"client-box\">\n        <div class=\"client-os\">iOS / iPadOS</div>\n        <div class=\"client-env\">iOS 15.0 及更高</div>\n        <p class=\"client-details\">需借助应用商店分发的网络分流工具。在添加订阅后允许安装本地 VPN 配置文件即可完成初始化。</p>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"faq-section\" id=\"faq\">\n    <div class=\"section-header\">\n      <div class=\"section-pretitle\">Inquiries</div>\n      <h2 class=\"section-title\">常见问题与排错规约</h2>\n      <p class=\"section-desc\">列载接入排查要点与配额运行中的常规边界说明。</p>\n    </div>\n\n    <ol class=\"faq-list\">\n      <li class=\"faq-item\">\n        <div class=\"faq-index\">01</div>\n        <div class=\"faq-content\">\n          <h3>订阅链接拉取失败或提示网络超时应如何排查？</h3>\n          <p>首先核验本地基础网络是否正常连通。若订阅链接在浏览器中亦无法打开，可尝试切换本地 DNS 服务器为公网解析地址（如 1.1.1.1 或 8.8.8.8）。部分受限网络环境可能拦截特定后缀，可在用户后台切换备用订阅域名。</p>\n        </div>\n      </li>\n      <li class=\"faq-item\">\n        <div class=\"faq-index\">02</div>\n        <div class=\"faq-content\">\n          <h3>多设备同时在线的计数依据是什么？</h3>\n          <p>系统依据并发连接会话与活跃 IP 记录进行动态核验。基础版上限为 3 台，旗舰版上限为 5 台，团队版上限为 20 台。若短时间内超过方案限定的独立终端阈值，多余的握手请求将被系统临时挂起直至旧会话释放。</p>\n        </div>\n      </li>\n      <li class=\"faq-item\">\n        <div class=\"faq-index\">03</div>\n        <div class=\"faq-content\">\n          <h3>月度数据流量配额重置周期的计算基准为何？</h3>\n          <p>流量周期以账单生成日的自然周期为准，而非统一的公历首日。当周期内的额度用尽后，节点将停止向该订阅分发流量，待下一个计费周期开始或办理额外增补包后自动恢复。</p>\n        </div>\n      </li>\n      <li class=\"faq-item\">\n        <div class=\"faq-index\">04</div>\n        <div class=\"faq-content\">\n          <h3>节点列表出现延迟测试超时（Timeout）应如何处理？</h3>\n          <p>测试超时通常是由本地防火墙阻断 ICMP/TCP 探测包、客户端本地监听端口冲突，或是特定节点正进行维护所致。建议先更新订阅以获取最新的可用节点列表，并在分流模式中切换至不同的传输协议进行验证。</p>\n        </div>\n      </li>\n    </ol>\n  </section>\n</main>\n\n<footer class=\"site-footer\">\n  <p>© 慈善机场 技术文档与节点参数发布系统 · 保留所有技术指标解释权</p>\n</footer>",
